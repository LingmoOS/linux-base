#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
set -eu

version=$1
image=$2

set -- ${DEB_MAINT_PARAMS:-unknown}

if [ "$1" = configure ]; then
  image_input=/usr/lib/modules/${version}/vmlinuz
  config_input=/usr/lib/modules/${version}/config
  config=$(dirname $image)/config-${version}
  if [ -e "$image_input" ]; then
    cp -l "$image_input" "$image" 2>/dev/null || cp -p "$image_input" "$image"
  fi
  if [ -e "$config_input" ]; then
    cp -l "$config_input" "$config" 2>/dev/null || cp -p "$config_input" "$config"
  fi
fi
